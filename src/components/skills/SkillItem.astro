---
interface Props {
	name: string;
	icon: string;
	description: string;
	projects: string[];
	technologies?: string[];
}

const { name, icon, description, projects, technologies } = Astro.props;
---

<div class="w-full bg-gray-50 rounded-lg p-4">
  <div class="flex items-center gap-3 mb-3">
    <div class="text-blue-500 w-6 h-6 flex items-center justify-center" set:html={icon} />
    <h3 class="text-lg font-bold text-gray-800">
      {name}
    </h3>
  </div>

  <div class="flex flex-col gap-3">
    <p class="text-gray-700 text-sm leading-relaxed whitespace-pre-line">
      {description}
    </p>

    {technologies && technologies.length > 0 ? (
      <div class="flex gap-2 flex-wrap">
        {technologies.map((tech) => (
          <span class="text-xs bg-blue-50 text-blue-700 px-2 py-1 rounded-md font-medium">
            {tech}
          </span>
        ))}
      </div>
    ) : null}

    {projects && projects.length > 0 ? (
      <div>
        <h4 class="text-xs font-semibold text-gray-500 mb-1 uppercase tracking-wide">
          Projects
        </h4>
        <div class="flex flex-col gap-1">
          {projects.map((project) => (
            <div class="flex items-center gap-2">
              <div class="w-1.5 h-1.5 rounded-full bg-gray-400 shrink-0" />
              <span class="text-sm text-gray-600">
                {project}
              </span>
            </div>
          ))}
        </div>
      </div>
    ) : null}
  </div>
</div>