interface Props {
	item: SectionItem;
}

const { item } = Astro.props;

const getIcon = (iconType: string) => {
	return iconTypes[iconType] || iconTypes.education;
};

const getDateRange = () => {
	if (item.isCurrent) {
		return `${item.year}年${item.month} - 現在`;
	}
	if (item.endYear && item.endMonth) {
		return `${item.year}年${item.month} - ${item.endYear}年${item.endMonth}`;
	}
	return `${item.year}年${item.month}`;
};
---

<div class="py-4 border-b border-gray-100 last:border-b-0">
  <div class="flex flex-col gap-2">
    <!-- 日付とアイコン -->
    <div class="flex items-center gap-3">
      <div class="text-gray-600 flex" set:html={getIcon(item.iconType)} />
      <span class="text-sm text-gray-500 font-medium">
        {getDateRange()}
      </span>
    </div>

    <!-- タイトル -->
    <h3 class="text-lg font-semibold text-gray-900 leading-tight">
      {item.title}
    </h3>

    <!-- 説明 -->
    {item.description ? (
      <p class="text-sm text-gray-600 leading-relaxed whitespace-pre-line">
        {item.description}
      </p>
    ) : null}
  </div>
</div>