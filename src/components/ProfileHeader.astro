---
import profileIcon from "../assets/profile-icon.jxl?url";
---

<header>
  <img
    src={profileIcon}
    alt="muhi111's profile icon"
    width={64}
    height={64}
    loading="eager"
    decoding="async"
  >
  <nav aria-label="Profile links">
    <ul>
      <li>
        <a
          href="https://github.com/muhi111"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
      </li>
      <li>
        <a
          href="https://qiita.com/muhi111"
          target="_blank"
          rel="noopener noreferrer"
        >
          Qiita
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
header {
  display: flex;
  align-items: center;
}

img {
  image-rendering: pixelated;
}

nav ul {
  list-style: none;
}

nav a {
  display: inline-block;
  min-height: 24px;
}
</style>
