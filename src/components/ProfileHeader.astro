---
import profileIcon from "../assets/profile-icon.jxl?url";
import { profile } from "../data/profile";
---

<header>
  <img
    src={profileIcon}
    alt={`${profile.name}'s profile icon`}
    width={64}
    height={64}
    loading="eager"
    decoding="async"
  >
  <h1>{profile.name}</h1>
  <p>{profile.bio}</p>
  <nav aria-label="Profile links">
    <ul>
      {profile.links.map((link) => (
        <li>
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
img {
  image-rendering: pixelated;
}

nav a {
  display: inline-block;
  min-height: 24px;
}
</style>
