---
import { articles } from "../lib/content";
import Section from "./Section.astro";
---

<Section title="記事">
  <ul class="grid gap-3">
    {articles.map((item) => (
        <li class="rounded-md border border-line bg-white p-4 shadow-sm transition hover:border-accent">
          <a href={item.url} target="_blank" rel="noopener noreferrer" class="block">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
              <h3 class="inline-flex text-balance items-start gap-2 font-semibold leading-7 text-ink">
                <span>{item.title}</span>
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  class="mt-1 h-4 w-4 shrink-0 text-accent-dark"
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                >
                  <path d="M15 3h6v6" />
                  <path d="M10 14 21 3" />
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                </svg>
              </h3>
              <p class="shrink-0 text-sm text-muted">{item.publishedAt}</p>
            </div>
            <p class="mt-2 text-sm text-accent-dark">{item.source}</p>
          </a>
        </li>
      ))}
  </ul>
</Section>
