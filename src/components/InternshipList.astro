---
import { internships } from "../lib/content";
import Section from "./Section.astro";
---

<Section title="インターン">
  <ol class="grid gap-4">
    {internships.map((item) => (
        <li class="rounded-md border border-line bg-white p-5 shadow-sm">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="text-lg font-semibold text-ink">{item.organization}</h3>
            </div>
            <p class="shrink-0 text-sm text-muted">
              {item.startDate}
              {item.endDate ? ` - ${item.endDate}` : item.current ? " - 現在" : ""}
            </p>
          </div>
          <p class="mt-3 text-pretty text-sm leading-7 text-muted">
            {item.description}
          </p>
        </li>
      ))}
  </ol>
</Section>
