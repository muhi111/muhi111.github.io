---
import ArticleItem from "../components/articles/ArticleItem.astro";
import { articlesData } from "../data/articlesData";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Articles | muhi111 Portfolio">
  <div class="min-h-[100dvh] flex flex-col py-2 md:py-12">
    <div class="max-w-4xl mx-auto px-1 md:px-4 w-full">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 text-center mb-12">
        Articles
      </h1>

      <div class="bg-white rounded-lg md:rounded-xl shadow-md p-4 md:p-8 max-w-4xl mx-auto">
        <div class="flex flex-col gap-0">
          {articlesData.map((article) => (
            <ArticleItem article={article} />
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>