{
  "name": "portfolio",
  "type": "module",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "playwright test",
    "check": "pnpm check:astro && pnpm check:biome && pnpm check:yaml && pnpm check:knip",
    "check:astro": "astro check",
    "check:biome": "biome check .",
    "check:yaml": "yamlfmt -lint .",
    "check:knip": "knip",
    "fix": "pnpm fix:biome && pnpm fix:yaml && pnpm fix:knip",
    "fix:biome": "biome check --write .",
    "fix:yaml": "yamlfmt .",
    "fix:knip": "knip --fix"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.8",
    "typescript": "^6.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@fullhuman/postcss-purgecss": "^9.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.4",
    "knip": "^6.40.0",
    "lefthook": "^2.2.1",
    "postcss": "^8.5.32"
  }
}
