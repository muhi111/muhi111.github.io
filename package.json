{
  "name": "portfolio",
  "type": "module",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "playwright test",
    "check": "pnpm check:astro && pnpm check:biome && pnpm check:yaml && pnpm check:knip",
    "check:astro": "astro check",
    "check:biome": "biome check .",
    "check:yaml": "yamlfmt -lint .",
    "check:knip": "knip",
    "fix": "pnpm fix:biome && pnpm fix:yaml && pnpm fix:knip",
    "fix:biome": "biome check --write .",
    "fix:yaml": "yamlfmt .",
    "fix:knip": "knip --fix"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "knip": "^6.24.0",
    "lefthook": "^2.1.9"
  }
}
